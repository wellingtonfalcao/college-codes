@page
@model wellington_falcao_DR4_AT.Pages.Reservas.DetailsModel

@{
    ViewData["Title"] = "Detalhes da Reserva";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Reserva</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Cliente
        </dt>
        <dd class="col-sm-10">
            @Model.Reserva.Cliente.Nome
            <br />
            <small class="text-muted">@Model.Reserva.Cliente.Email</small>
        </dd>

        <dt class="col-sm-2">
            Pacote Turístico
        </dt>
        <dd class="col-sm-10">
            @Model.Reserva.PacoteTuristico.Titulo
            <br />
            <small class="text-muted">
                Preço: R$ @Model.Reserva.PacoteTuristico.Preco<br />
                Data de Início: @Model.Reserva.PacoteTuristico.DataInicio.ToString("dd/MM/yyyy")<br />
                Capacidade: @Model.Reserva.PacoteTuristico.CapacidadeMaxima pessoas
            </small>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reserva.DataReserva)
        </dt>
        <dd class="col-sm-10">
            @Model.Reserva.DataReserva.ToString("dd/MM/yyyy")
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Reserva.Id">Editar</a>
    <a asp-page="./Index">Voltar para a Lista</a>
</div>
