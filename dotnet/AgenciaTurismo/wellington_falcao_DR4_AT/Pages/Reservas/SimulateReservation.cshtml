@page
@model AgenciaTurismo.Pages.Reservas.SimulateReservationModel

@{
    ViewData["Title"] = "Simular Reserva";
}

<h2>Simular Reserva</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="form-group mb-3">
                <label asp-for="QuantidadeParticipantes" class="form-label">Quantidade de Participantes:</label>
                <input asp-for="QuantidadeParticipantes" class="form-control" min="1" />
                <span asp-validation-for="QuantidadeParticipantes" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PacoteTuristicoId" class="form-label">Pacote Turístico:</label>
                <select asp-for="PacoteTuristicoId" class="form-control">
                    <option value="">Selecione um pacote</option>
                    @foreach (var pacote in Model.Pacotes)
                    {
                        <option value="@pacote.Id">@pacote.Titulo - @pacote.Preco.ToString("C")</option>
                    }
                </select>
                <span asp-validation-for="PacoteTuristicoId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Calcular Valor</button>
                <a asp-page="Index" class="btn btn-secondary">Voltar para Lista</a>
            </div>
        </form>
    </div>
</div>

@if (Model.ValorTotal > 0)
{
    <div class="alert alert-info mt-4">
        <h5>Resultado da Simulação:</h5>
        <p class="mb-1"><strong>Valor Total da Reserva:</strong> @Model.ValorTotal.ToString("C")</p>
        <p class="mb-0"><small>Para @Model.QuantidadeParticipantes participante(s)</small></p>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}