@page
@model Infnet.Pages.Emails.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Email</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email.Mail" class="control-label"></label>
                <input asp-for="Email.Mail" class="form-control" />
                <span asp-validation-for="Email.Mail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email.AlunoId" class="control-label"></label>
                <select asp-for="Email.AlunoId" class ="form-control" asp-items="ViewBag.AlunoId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="/Emails/Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
