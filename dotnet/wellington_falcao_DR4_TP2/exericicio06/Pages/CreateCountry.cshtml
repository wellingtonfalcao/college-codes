@page "/"
@model exercicio06.Pages.CountryManager.CreateCountryModel
@{
    ViewData["Title"] = "Cadastrar País";
}

<h2>Cadastrar País</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Input.CountryName" class="form-label"></label>
        <input asp-for="Input.CountryName" class="form-control" />
        <span asp-validation-for="Input.CountryName" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Input.CountryCode" class="form-label"></label>
        <input asp-for="Input.CountryCode" class="form-control" />
        <span asp-validation-for="Input.CountryCode" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Salvar</button>
</form>

@if (Model.Country != null)
{
    <div class="alert alert-success mt-3">
        País cadastrado: <strong>@Model.Country.CountryName</strong> (@Model.Country.CountryCode)
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
