@page "/"
@model CityManager.CreateCityModel
@{
    ViewData["Title"] = "Cadastrar Cidade";
}

<h2>Cadastrar Cidade Turística</h2>

<form method="post">
    <div class="form-group">
        <label for="CityName">Nome da Cidade</label>
        <input asp-for="CityName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Salvar</button>
</form>

@if (!string.IsNullOrEmpty(Model.SubmittedCity))
{
    <div class="alert alert-success mt-3">
        Cidade cadastrada: <strong>@Model.SubmittedCity</strong>
    </div>
}
