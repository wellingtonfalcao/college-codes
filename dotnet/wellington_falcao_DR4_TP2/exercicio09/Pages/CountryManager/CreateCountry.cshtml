@page "/createcountry"
@model exercicio09.Pages.CountryManager.CreateCountryModel
@{
    ViewData["Title"] = "Cadastrar Múltiplos Países";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    @for (int i = 0; i < Model.Inputs.Count; i++)
    {
        <div class="row mb-2">
            <div class="col">
                <label asp-for="Inputs[i].CountryName" class="form-label"></label>
                <input asp-for="Inputs[i].CountryName" class="form-control" />
                <span asp-validation-for="Inputs[i].CountryName" class="text-danger"></span>
            </div>
            <div class="col">
                <label asp-for="Inputs[i].CountryCode" class="form-label"></label>
                <input asp-for="Inputs[i].CountryCode" class="form-control" />
                <span asp-validation-for="Inputs[i].CountryCode" class="text-danger"></span>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Salvar Todos</button>
</form>

@if (Model.Countries != null && Model.Countries.Count > 0)
{
    <h3 class="mt-4">Países cadastrados:</h3>
    <ul class="list-group">
        @foreach (var c in Model.Countries)
        {
            <li class="list-group-item">@c.CountryName (@c.CountryCode)</li>
        }
    </ul>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
