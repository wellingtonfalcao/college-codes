@page "/create10"
@model WebApplication2.Pages.Create10Model
@{
    ViewData["Title"] = "Validação Customizada";
}

<h2>Cadastro com Validação Customizada</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Input.Nome"></label>
        <input asp-for="Input.Nome" class="form-control" />
        <span asp-validation-for="Input.Nome" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.SobreNome"></label>
        <input asp-for="Input.SobreNome" class="form-control" />
        <span asp-validation-for="Input.SobreNome" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
</form>

@if (!string.IsNullOrEmpty(Model.Resultado)) {
    <div class="alert alert-success mt-3">
        @Model.Resultado
    </div>
}