@page "/create8"
@model WebApplication2.Pages.Create8Model;
@{
    ViewData["Title"] = "Criar conta";
}

<h1>Criar com validação no cliente</h1>
<h2>Conta</h2>
<div>
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <label asp-for="Input.Nome"></label>
            <input asp-for="Input.Nome" class="form-control" />
            <span asp-validation-for="Input.Nome" class="text-danger"></span>
            <p></p>
            <label asp-for="Input.Saldo"></label>
            <input asp-for="Input.Saldo" class="form-control" />
            <span asp-validation-for="Input.Saldo" class="text-danger"></span>
            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@if (Model.Conta2 != null) {
    <div class="alert alert-success mt-3">
        Conta preenchida: <strong>@Model.Conta2</strong>
    </div>
}

@section Scripts {
    <!-- Requer validação do lado do cliente -->
    <partial name="_ValidationScriptsPartial" />
}
